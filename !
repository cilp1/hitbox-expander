-- ─────────────────────────────────────────────
-- TOGGLE UI FUNCTION
-- ─────────────────────────────────────────────
local function toggleUI()
    if not sg then
        pcall(createUI)
        return
    end
    guiVisible = not guiVisible
    sg.Enabled = guiVisible
    if guiVisible and frame and contentFrame then
        contentFrame.Visible = true
        frame:TweenSize(UDim2.new(0, 260, 0, 190), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    end
end

-- ─────────────────────────────────────────────
-- KEYBOARD SHORTCUTS
-- ─────────────────────────────────────────────
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.End then
        toggleUI()
    end
end)

