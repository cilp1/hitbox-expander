--[[
    HITBOX EXPANDER - Fully Fixed UI
    All elements visible, proper sizing, END key to toggle
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
if not player then
    repeat task.wait() until Players.LocalPlayer
    player = Players.LocalPlayer
end

-- ─────────────────────────────────────────────
-- CONFIGURATION
-- ─────────────────────────────────────────────
local CONFIG = {
    HITBOX_SIZE = Vector3.new(8, 8, 8),
    DEFAULT_SIZE = Vector3.new(2, 2, 1),
    UPDATE_INTERVAL = 0.5,
    AUTO_ENABLE = true,
}

-- ─────────────────────────────────────────────
-- STATE
-- ─────────────────────────────────────────────
local hitboxOn = false
local lastHitboxApply = 0
local torsoCache = {}
local hitboxPlayerHooked = false
local guiVisible = true
local sg = nil
local frame = nil
local isMinimized = false

-- ─────────────────────────────────────────────
-- HELPERS
-- ─────────────────────────────────────────────
local function getTorso(char)
    if not char then return nil end
    return char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function getCachedTorso(p2)
    if torsoCache[p2] and torsoCache[p2].Parent then
        return torsoCache[p2]
    end
    local char = p2.Character
    if not char then return nil end
    local t = getTorso(char)
    torsoCache[p2] = t
    return t
end

local function invalidateTorsoCache(p2)
    torsoCache[p2] = nil
end

local function applyHitbox(char, enlarged)
    if not char then return end
    local torso = getTorso(char)
    if not torso then return end
    
    if enlarged then
        torso.Size = CONFIG.HITBOX_SIZE
        torso.Transparency = 1
        torso.CanCollide = false
        torso.Material = Enum.Material.Neon
    else
        torso.Size = CONFIG.DEFAULT_SIZE
        torso.Transparency = 0
        torso.CanCollide = true
        torso.Material = Enum.Material.Plastic
    end
end

-- ─────────────────────────────────────────────
-- CORE FUNCTIONS
-- ─────────────────────────────────────────────
local function setHitboxes(enlarged)
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            if enlarged then
                local torso = getCachedTorso(other)
                if torso then
                    torso.Size = CONFIG.HITBOX_SIZE
                    torso.Transparency = 1
                    torso.CanCollide = false
                    torso.Material = Enum.Material.Neon
                end
            else
                applyHitbox(other.Character, false)
                invalidateTorsoCache(other)
            end
        end
    end
end

local function hitboxActivate()
    hitboxOn = true
    if not hitboxPlayerHooked then
        hitboxPlayerHooked = true
        Players.PlayerAdded:Connect(function(p2)
            if hitboxOn and p2 ~= player then
                p2.CharacterAdded:Connect(function(char)
                    task.wait(0.1)
                    if hitboxOn then applyHitbox(char, true) end
                end)
            end
        end)
    end
    print("🔴 Hitbox Expander ENABLED")
    updateStatusText()
end

local function hitboxDeactivate()
    hitboxOn = false
    setHitboxes(false)
    print("⚪ Hitbox Expander DISABLED")
    updateStatusText()
end

local function hitboxRender()
    if not hitboxOn then return end
    local now = tick()
    if now - lastHitboxApply < CONFIG.UPDATE_INTERVAL then return end
    lastHitboxApply = now
    setHitboxes(true)
end

-- ─────────────────────────────────────────────
-- PLAYER CACHE MANAGEMENT
-- ─────────────────────────────────────────────
local function hookPlayerCache(p2)
    p2.CharacterAdded:Connect(function()
        invalidateTorsoCache(p2)
    end)
end

for _, p2 in ipairs(Players:GetPlayers()) do
    hookPlayerCache(p2)
end
Players.PlayerAdded:Connect(hookPlayerCache)
Players.PlayerRemoving:Connect(function(p2)
    torsoCache[p2] = nil
end)

-- ─────────────────────────────────────────────
-- RUNTIME LOOPS
-- ─────────────────────────────────────────────
RunService.RenderStepped:Connect(hitboxRender)

